{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxSAI",
  "version": "0.1.0",
  "identifier": "com.fluxsai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FluxSAI — SmartAI Editor",
        "width": 1024,
        "height": 600,
        "minWidth": 900,
        "minHeight": 400,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
